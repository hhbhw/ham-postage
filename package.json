{
  "name": "ham-postage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "HAM QSL 寄卡资费比价器（中国邮政国际/港澳台）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm run gen:data && vite build",
    "preview": "vite preview",
    "gen:data": "node scripts/csv-to-json.mjs && node scripts/gen-pinyin.mjs",
    "prebuild": "npm run gen:data",
    "predev": "npm run gen:data",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "preact": "^10.22.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.0",
    "pinyin-pro": "^3.28.1",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^1.6.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
